# Configuración de PiScouting. Copia este fichero a `.env` (en la raíz del repo) y ajusta valores.
# El backend carga `.env` automáticamente al arrancar. NO subas tu `.env` real a git.

# Secreto para firmar los tokens JWT de login. OBLIGATORIO cambiarlo en producción.
# Genera uno con: python -c "import secrets; print(secrets.token_urlsafe(48))"
PISCOUTING_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio

# Días de validez de la sesión (token JWT). Opcional, por defecto 30.
PISCOUTING_TOKEN_TTL_DAYS=30

# Token para el endpoint de actualización (POST /api/admin/refresh, cabecera X-Admin-Token).
# Si no se define, ese endpoint queda deshabilitado. Lo llama el cron horario de la VM.
PISCOUTING_ADMIN_TOKEN=cambia-esto-por-otro-secreto-aleatorio

# Temporada que enseña la app: 2025 = 2025/26. Opcional (por defecto 2025). El refresco se
# trae solo el calendario de la temporada siguiente cuando la FEB lo publica; cuando quieras
# pasarte a ella, cambia esto y reinicia. Las ligas fantasy ya creadas no se ven afectadas.
# PISCOUTING_SEASON=2026

# --- Solo para el despliegue en VM con docker-compose (Azure/DigitalOcean) ---
# Dominio del backend para el HTTPS automático de Caddy (p.ej. api.tudominio.com).
# Para pruebas sin dominio, usa  DOMAIN=:80  (HTTP por la IP de la VM).
DOMAIN=api.tudominio.com
# Origen(es) del frontend permitidos por CORS (coma-separados), p.ej. https://palodo.github.io
FRONTEND_ORIGIN=https://TU-FRONTEND

# Entrar con Google. Se saca en console.cloud.google.com (Credenciales -> ID de cliente de OAuth, tipo Aplicación web).
# Es público: va dentro del botón. El secreto de cliente NO se usa.
# Sin esta variable, la web no enseña el botón ni carga el script de Google.
GOOGLE_CLIENT_ID=

# Correo saliente para "he olvidado mi contraseña". Vale cualquier SMTP: Brevo
# (smtp-relay.brevo.com:587), Gmail con contraseña de aplicación, el del hosting...
# Si se deja vacío no se manda nada y el administrador genera el enlace desde la app.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PiFantasy <hola@pifantasy.com>
# Base de los enlaces que van dentro de los correos
APP_URL=https://pifantasy.com
