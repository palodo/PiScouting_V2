# Caddy sirve la web del fantasy (estática) y hace de proxy de /api hacia el backend.
# Mismo origen -> sin CORS. DOMAIN=:80 para HTTP por IP; un dominio real = HTTPS auto.
{$DOMAIN} {
	encode gzip
	handle /api/* {
		reverse_proxy app:8080
	}
	handle {
		root * /srv
		# {path}.html permite servir /privacidad y /condiciones sin extensión;
		# el resto cae en index.html, que es la app (una sola página).
		try_files {path} {path}.html /index.html
		file_server
	}
}
